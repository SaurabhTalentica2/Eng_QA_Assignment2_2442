# Google Gemini API key (free tier)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (LiteLLM format).
#   gemini/gemini-3.6-flash
#   gemini/gemini-2.5-flash
MODEL_NAME=gemini/gemini-3.6-flash

# VAmPI target (local Docker container only - authorized testing)
VAMPI_BASE_URL=http://localhost:5000

# Politeness / safety: delay between HTTP requests (seconds) and per-test cap
REQUEST_DELAY_SECONDS=0.2
MAX_REQUESTS_PER_TEST=25
